<div class="reservation-confirm">

  <h1>予約内容の確認</h1>

  <p><strong>チェックイン</strong></p>
  <p><%= @reservation.start_date.strftime("%Y/%m/%d") %></p>

  <p><strong>チェックアウト</strong></p>
  <p><%= @reservation.end_date.strftime("%Y/%m/%d") %></p>

  <p><strong>日数</strong></p>
  <p><%= (@reservation.end_date - @reservation.start_date).to_i %>日</p>

  <p><strong>人数</strong></p>
  <p><%= @reservation.person_num %>人</p>

  <p><strong>お支払い金額</strong></p>
  <p>
    ¥<%= number_with_delimiter(
      @room.price *
      (@reservation.end_date - @reservation.start_date).to_i *
      @reservation.person_num
    ) %>
  </p>

  <p>上記内容で正しければ「確定」ボタンを押してください。</p>

  <%= form_with model: @reservation, url: room_reservations_path(@room), local: true, method: :post do |form| %>
    <%= form.hidden_field :start_date %>
    <%= form.hidden_field :end_date %>
    <%= form.hidden_field :person_num %>

    <%= form.submit "予約を確定" %>
  <% end %>

  <%= link_to "キャンセル", room_path(@room) %>

</div>