<div class="signup-box">

  <h2>新規登録</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

<div class="field">
  <%= f.label :name, "ユーザー名" %>
  <%= f.text_field :name %>

  <% resource.errors.full_messages_for(:name).each do |message| %>
    <p class="error-message"><%= message %></p>
  <% end %>
</div>

<div class="field">
  <%= f.label :email, "メールアドレス" %>
  <%= f.email_field :email, autofocus: true, autocomplete: "email" %>

  <% resource.errors.full_messages_for(:email).each do |message| %>
    <p class="error-message"><%= message %></p>
  <% end %>
</div>

<div class="field">
  <%= f.label :password, "パスワード" %>

  <% if @minimum_password_length %>
    <p class="password-note">
      （<%= @minimum_password_length %>文字以上）
    </p>
  <% end %>

  <%= f.password_field :password, autocomplete: "new-password" %>

  <% resource.errors.full_messages_for(:password).each do |message| %>
    <p class="error-message"><%= message %></p>
  <% end %>
</div>

<div class="field">
  <%= f.label :password_confirmation, "確認用パスワード" %>
  <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
</div>

<div class="actions">
  <%= f.submit "新しいアカウントを作成" %>
</div>

<% end %>

<%= link_to "アカウントをお持ちの方はログイン",
new_user_session_path,
class: "login-button" %>

</div>
