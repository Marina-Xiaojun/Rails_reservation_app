<header>
    <h1>
    <%= link_to "Potepan Share", root_path %>
  </h1>

  <nav>
  <% if user_signed_in? %>

    <div class="user-menu">
      <button type="button"><%= current_user.name %></button>

      <div class="user-menu-box">
        <%= link_to "施設の新規登録", new_room_path %>
        <%= link_to "予約済み一覧", my_reservations_path %>
        <%= link_to "登録済み一覧", my_rooms_path %>
        <%= link_to "アカウント設定", account_path %>

        <%= link_to "ログアウト", destroy_user_session_path,
                    data: { turbo_method: :delete } %>
      </div>
    </div>

  <% else %>
    <%= link_to "ログイン", new_user_session_path %>
    <%= link_to "新規登録", new_user_registration_path, class: "signup-button" %>
  <% end %>
  </nav>
  </header>
