<div class="settings-page">

  <div class="settings-menu">
    <h3>設定</h3>

    <%= link_to "アカウント", account_path %>
    <%= link_to "プロフィール", profile_path %>
  </div>

  <div class="account-content">

    <h2>アカウント編集</h2>
    <% if @user.errors.any? %>
   <div>
    <% @user.errors.full_messages.each do |message| %>
      <p style="color: red;"><%= message %></p>
    <% end %>
   </div>
 <% end %>

    <%= form_with model: current_user, url: account_update_path, method: :patch do |form| %>

      <div>
        <%= form.label :email, "メールアドレス" %>
        <%= form.email_field :email %>
      </div>

      <div>
        <%= form.label :password, "変更後パスワード" %>
        <p>※変更する場合のみ</p>
        <%= form.password_field :password %>
      </div>

      <div>
        <%= form.label :password_confirmation, "確認用パスワード" %>
        <p>※変更する場合のみ</p>
        <%= form.password_field :password_confirmation %>
      </div>

      <div>
        <%= form.label :current_password, "現在のパスワード" %>
        <%= form.password_field :current_password %>
      </div>

      <div>
        <%= link_to "キャンセル", account_path %>
        <%= form.submit "保存" %>
      </div>

    <% end %>

  </div>

</div>
